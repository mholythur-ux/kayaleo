# Copy to .env and fill in. These are PUBLIC client keys — safe for the app.
# NEVER put the Supabase SERVICE_ROLE key in this file.

# Supabase Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL of the Kaya Leo backend (this repo's /server).
# On a physical device use your computer's LAN IP, e.g. http://192.168.1.10:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
